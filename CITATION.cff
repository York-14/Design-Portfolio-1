title: "Beauty Between Order and Chaos"
type: software
authors:
  - name: "York-14"
    website: "https://github.com/York-14"
date-released: "2026-10-04"
url: "https://york-14.github.io/Design-Portfolio-1/ivy-order-chaos/"
